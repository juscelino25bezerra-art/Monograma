<?xml version="1.0" encoding="utf-8"?>
<!-- YEWPLAY(listen): a tela Ouvir da proposta (p. 16) - fundo tingido pela cor da capa, capa grande
     quadrada (raio 22dp), título em Bricolage com Salvar ao lado, barra com os tempos, controles
     amplos (aleatório, anterior, tocar/pausar num círculo marfim, próximo, repetir) e embaixo
     velocidade, timer, compartilhar e fila. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/yew_listen_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/newtubeColorBackground">

    <View
        android:id="@+id/yew_listen_tint"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="@dimen/yew_side_margin"
        android:paddingEnd="@dimen/yew_side_margin">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="56dp">

            <ImageButton
                android:id="@+id/yew_listen_close"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="start|center_vertical"
                android:layout_marginStart="-12dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/yew_listen_close"
                android:padding="12dp"
                android:src="@drawable/ic_yew_caret_down"
                android:tint="@color/mobile_color_on_surface" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/yew_listen_now_playing"
                    android:textColor="@color/mobile_color_on_surface_secondary"
                    android:textSize="11.5sp" />

                <TextView
                    android:id="@+id/yew_listen_source"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/instrument_semibold"
                    android:maxWidth="220dp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:text="@string/yew_watch_listen"
                    android:textColor="@color/mobile_color_on_surface"
                    android:textSize="13sp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/yew_listen_more"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="-12dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/mobile_player_more"
                android:padding="12dp"
                android:src="@drawable/ic_yew_dots"
                android:tint="@color/mobile_color_on_surface" />
        </FrameLayout>

        <!-- The cover stays square: MobileListenActivity sizes the card to the box's shorter side. -->
        <FrameLayout
            android:id="@+id/yew_listen_cover_box"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="20dp"
            android:layout_weight="1">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/yew_listen_cover_card"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                app:cardBackgroundColor="?attr/newtubeColorSurface"
                app:cardCornerRadius="22dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <ImageView
                    android:id="@+id/yew_listen_cover"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:scaleType="centerCrop" />
            </com.google.android.material.card.MaterialCardView>
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/yew_listen_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="@font/bricolage_bold"
                    android:letterSpacing="-0.01"
                    android:maxLines="2"
                    android:textColor="@color/mobile_color_on_surface"
                    android:textSize="22sp"
                    tools:text="Trilha para foco" />

                <TextView
                    android:id="@+id/yew_listen_author"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/mobile_color_on_surface_secondary"
                    android:textSize="13.5sp"
                    tools:text="Estúdio Calmo" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/yew_listen_save"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginEnd="-12dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/mobile_watch_save"
                android:padding="12dp"
                android:src="@drawable/ic_yew_saved"
                android:tint="@color/mobile_color_on_surface" />
        </LinearLayout>

        <SeekBar
            android:id="@+id/yew_listen_seek"
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:layout_marginStart="-16dp"
            android:layout_marginTop="14dp"
            android:layout_marginEnd="-16dp"
            android:max="1000"
            android:progressBackgroundTint="@color/mobile_color_raised"
            android:progressTint="@color/mobile_color_on_surface"
            android:splitTrack="false"
            android:thumbTint="@color/mobile_color_on_surface" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/yew_listen_position"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/mobile_color_on_surface_secondary"
                android:textSize="11.5sp"
                tools:text="1:41" />

            <TextView
                android:id="@+id/yew_listen_remaining"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:textColor="@color/mobile_color_on_surface_secondary"
                android:textSize="11.5sp"
                tools:text="-2:17" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/yew_listen_shuffle"
                style="@style/YewListenControl"
                android:contentDescription="@string/mobile_menu_shuffle"
                android:src="@drawable/ic_yew_shuffle" />

            <ImageButton
                android:id="@+id/yew_listen_prev"
                style="@style/YewListenControl"
                android:contentDescription="@string/yew_listen_previous"
                android:padding="10dp"
                android:src="@drawable/ic_yew_skip_prev" />

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.3">

                <ImageButton
                    android:id="@+id/yew_listen_play"
                    android:layout_width="68dp"
                    android:layout_height="68dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_yew_listen_play"
                    android:contentDescription="@string/mobile_mini_play_pause"
                    android:padding="20dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_yew_pause"
                    android:tint="@color/mobile_color_on_inverse_surface" />
            </FrameLayout>

            <ImageButton
                android:id="@+id/yew_listen_next"
                style="@style/YewListenControl"
                android:contentDescription="@string/yew_mini_next"
                android:padding="10dp"
                android:src="@drawable/ic_yew_skip_next" />

            <ImageButton
                android:id="@+id/yew_listen_repeat"
                style="@style/YewListenControl"
                android:contentDescription="@string/mobile_menu_repeat"
                android:src="@drawable/ic_yew_repeat" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/yew_listen_tools"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:layout_marginBottom="20dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/yew_listen_speed"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/mobile_player_speed"
                android:fontFamily="@font/instrument_semibold"
                android:gravity="center"
                android:textColor="@color/mobile_color_on_surface_secondary"
                android:textSize="13sp"
                tools:text="1×" />

            <ImageButton
                android:id="@+id/yew_listen_timer"
                style="@style/YewListenTool"
                android:contentDescription="@string/yew_listen_timer"
                android:src="@drawable/ic_yew_timer" />

            <ImageButton
                android:id="@+id/yew_listen_share"
                style="@style/YewListenTool"
                android:contentDescription="@string/mobile_watch_share"
                android:src="@drawable/ic_yew_share" />

            <ImageButton
                android:id="@+id/yew_listen_queue"
                style="@style/YewListenTool"
                android:contentDescription="@string/mobile_menu_queue"
                android:src="@drawable/ic_yew_queue_list" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
