<?xml version="1.0" encoding="utf-8"?>
<!-- YEWPLAY(nav): o mini-player sobre uma tela de detalhe (Busca, Canal) - a mesma linha da barra
     flutuante do Browse (mobile_mini_player_row), numa barra própria no pé da tela. -->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mobile_mini_player"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="bottom"
    android:layout_marginStart="@dimen/yew_capsule_margin"
    android:layout_marginEnd="@dimen/yew_capsule_margin"
    android:layout_marginBottom="@dimen/yew_capsule_margin"
    android:clickable="true"
    android:contentDescription="@string/mobile_mini_expand"
    android:focusable="true"
    android:visibility="gone"
    app:cardBackgroundColor="?attr/newtubeColorCard"
    app:cardCornerRadius="@dimen/yew_capsule_radius"
    app:cardElevation="8dp"
    app:strokeColor="@color/mobile_color_divider"
    app:strokeWidth="1dp"
    tools:visibility="visible">

    <include layout="@layout/mobile_mini_player_row" />
</com.google.android.material.card.MaterialCardView>
