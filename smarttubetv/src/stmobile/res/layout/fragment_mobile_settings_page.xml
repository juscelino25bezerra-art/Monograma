<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/newtubeColorBackground"
    android:orientation="vertical">

    <!-- YEWPLAY(settings): título grande (Bricolage, proposta p. 18) numa linha própria, abaixo
         da seta de voltar, como os títulos de tela do Início e da Biblioteca. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp">

        <ImageButton
            android:id="@+id/settings_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="6dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/mobile_dialog_back"
            android:padding="12dp"
            android:src="@drawable/ic_mobile_back_arrow" />

        <!-- YEWPLAY(settings): a busca da proposta (p. 17) é a lupa no topo, não um campo; o id é o
             do campo antigo, então quem abre a busca (SettingsSearchFragment) não muda. -->
        <ImageButton
            android:id="@+id/settings_search_field"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="end"
            android:layout_marginEnd="6dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/mobile_settings_search_hint"
            android:padding="12dp"
            android:src="@drawable/ic_yew_magnifier"
            android:tint="@color/mobile_color_on_surface"
            android:visibility="gone"
            tools:visibility="visible" />
    </FrameLayout>

    <TextView
        android:id="@+id/settings_title"
        android:fontFamily="@font/bricolage_bold"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="2"
        android:paddingStart="@dimen/mobile_settings_title_inset"
        android:paddingTop="2dp"
        android:paddingEnd="20dp"
        android:paddingBottom="10dp"
        android:textAppearance="@style/TextAppearance.Yew.ScreenTitle"
        tools:text="Settings" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/settings_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="16dp"
        android:scrollbars="vertical"
        tools:listitem="@layout/item_mobile_settings_row" />

</LinearLayout>
