<?xml version="1.0" encoding="utf-8"?>
<!-- A group title inside a settings page. YEWPLAY(settings): pequeno e cinza quente, como na
     proposta (p. 18); o que se lê primeiro são as linhas. -->
<TextView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/settings_header_title"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:accessibilityHeading="true"
    android:fontFamily="@font/instrument_semibold"
    android:paddingStart="@dimen/mobile_settings_row_inset"
    android:paddingTop="24dp"
    android:paddingEnd="@dimen/mobile_settings_row_inset"
    android:paddingBottom="6dp"
    android:textColor="@color/mobile_color_on_surface_secondary"
    android:textSize="@dimen/mobile_settings_header_size"
    tools:text="Network" />
