<?xml version="1.0" encoding="utf-8"?>
<!--
  Touch Channel page (Wave 4a; tabbed 2026-07-09).

  YouTube-style but pure Material: the channel's sections (Videos / Live / Playlists /
  Shorts / ...) are Material TABS, and the selected section renders below as the standard
  full-width card feed (same VideoCardAdapter as Home/Search). No nested horizontal
  carousels (TV MultipleRowsFragment) and no interleaved mega-list (the pre-tab design).
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mobile_channel_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?attr/newtubeColorBackground"
        android:orientation="vertical">

    <LinearLayout
        android:id="@+id/mobile_channel_toolbar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/mobile_title_bar_height"
        android:background="?attr/newtubeColorBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/mobile_channel_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/mobile_back"
            android:padding="12dp"
            android:src="@drawable/ic_mobile_back_arrow" />

        <TextView
            android:id="@+id/mobile_channel_title"
        android:fontFamily="@font/bricolage_bold"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:paddingEnd="16dp"
            android:text="@string/header_channels"
            android:textColor="@color/mobile_color_on_surface"
            android:textSize="18sp"
            android:textStyle="bold"
            tools:text="Some Channel" />

    </LinearLayout>

    <!-- YEWPLAY(channel): o topo do canal da proposta (p. 14) - avatar em quadrado arredondado e o
         nome em Bricolage, sobre um banner suave na cor da página (o app não recebe a imagem de
         banner do canal). O título da barra some enquanto este bloco aparece. -->
    <LinearLayout
        android:id="@+id/yew_channel_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_yew_channel_banner"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/yew_side_margin"
        android:paddingTop="8dp"
        android:paddingEnd="@dimen/yew_side_margin"
        android:paddingBottom="14dp">

        <ImageView
            android:id="@+id/yew_channel_avatar"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop"
            android:src="@drawable/bg_card_avatar_placeholder" />

        <TextView
            android:id="@+id/yew_channel_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:accessibilityHeading="true"
            android:ellipsize="end"
            android:fontFamily="@font/bricolage_bold"
            android:letterSpacing="-0.015"
            android:maxLines="2"
            android:textColor="@color/mobile_color_on_surface"
            android:textSize="24sp"
            tools:text="Finanças em Casa" />
    </LinearLayout>

    <!-- One tab per channel section, in delivery order. Hidden until sections arrive.
         tabMaxWidth=0 lifts Material's 264dp cap (it wrapped long section names such as
         "WING IT! Production Logs (Pet Projects)" onto two lines); with 0 a scrollable tab
         takes its text's width, up to the screen width minus 56dp, like YouTube's tabs. -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/mobile_channel_tabs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/newtubeColorBackground"
        android:visibility="gone"
        app:tabIndicator="@drawable/bg_yew_tab_dot"
        app:tabIndicatorColor="@color/mobile_color_accent"
        app:tabIndicatorHeight="4dp"
        app:tabMaxWidth="0dp"
        app:tabMode="scrollable"
        app:tabRippleColor="@color/mobile_color_divider"
        app:tabSelectedTextColor="@color/mobile_color_on_surface"
        app:tabTextAppearance="@style/TextAppearance.Yew.Tab"
        app:tabTextColor="@color/mobile_color_on_surface_secondary"
        tools:visibility="visible" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Pull-to-refresh reloads the channel (ChannelPresenter.reload), like Home; the rows on
             screen stay until fresh ones land. Also the retry gesture over the failure state,
             which doesn't consume touches. -->
        <com.newtube.mobile.ui.common.HapticSwipeRefreshLayout
            android:id="@+id/mobile_channel_swipe"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/mobile_channel_grid"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingHorizontal="@dimen/mobile_card_spacing"
                android:paddingBottom="@dimen/mobile_card_spacing"
                android:scrollbars="vertical"
                tools:listitem="@layout/item_video_card" />

        </com.newtube.mobile.ui.common.HapticSwipeRefreshLayout>

        <!-- First page failed / came back empty: message + Try again (PageLoadState). -->
        <include layout="@layout/mobile_page_load_state" />

        <ProgressBar
            android:id="@+id/mobile_channel_progress"
            style="?android:attr/progressBarStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone"
            android:indeterminateTint="@color/mobile_color_primary"
            android:indeterminateTintMode="src_in" />

    </FrameLayout>

    </LinearLayout>

    <!-- Channel navigation from the watch page keeps playback alive in this overlay. -->
    <include layout="@layout/mobile_mini_player_overlay" />

</FrameLayout>
