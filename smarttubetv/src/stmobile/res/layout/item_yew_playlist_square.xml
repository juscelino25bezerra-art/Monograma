<?xml version="1.0" encoding="utf-8"?>
<!-- YEWPLAY(library): uma playlist em "Suas playlists" (proposta p. 15) - capa quadrada de raio
     14dp, nome e contagem embaixo. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="148dp"
    android:layout_height="wrap_content"
    android:layout_marginEnd="12dp"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="148dp"
        android:layout_height="148dp"
        app:cardBackgroundColor="?attr/newtubeColorSurface"
        app:cardCornerRadius="14dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp">

        <ImageView
            android:id="@+id/yew_playlist_square_cover"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:scaleType="centerCrop" />
    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/yew_playlist_square_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:ellipsize="end"
        android:fontFamily="@font/instrument_semibold"
        android:maxLines="1"
        android:textColor="@color/mobile_color_on_surface"
        android:textSize="13.5sp"
        tools:text="Importante" />

    <TextView
        android:id="@+id/yew_playlist_square_meta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/mobile_color_on_surface_secondary"
        android:textSize="12.5sp"
        tools:text="4 vídeos" />
</LinearLayout>
