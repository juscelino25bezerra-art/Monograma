<?xml version="1.0" encoding="utf-8"?>
<!-- MONOGRAMA(visual): a choice shown in place as a segmented control (Theme: System / Light /
     Dark; Buffer: Low / Medium / High). Title and summary as a row's, then one segment per option
     (added by SettingsAdapter), the selected one coral. Inside the group card like any row. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/mobile_settings_card_margin"
    android:layout_marginEnd="@dimen/mobile_settings_card_margin"
    android:background="@drawable/bg_settings_group_single"
    android:orientation="vertical">

    <View
        android:id="@+id/settings_row_separator"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="@dimen/mobile_settings_row_inset"
        android:background="@color/mobile_color_divider"
        android:importantForAccessibility="no"
        android:visibility="gone" />

    <TextView
        android:id="@+id/settings_row_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/mobile_settings_row_padding_vertical"
        android:fontFamily="@font/manrope_bold"
        android:paddingStart="@dimen/mobile_settings_row_inset"
        android:paddingEnd="@dimen/mobile_settings_row_inset"
        android:textColor="@color/mobile_color_on_surface"
        android:textSize="@dimen/mobile_settings_row_title_size"
        tools:text="Buffer" />

    <TextView
        android:id="@+id/settings_row_summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:paddingStart="@dimen/mobile_settings_row_inset"
        android:paddingEnd="@dimen/mobile_settings_row_inset"
        android:textColor="@color/mobile_color_on_surface_secondary"
        android:textSize="@dimen/mobile_settings_row_summary_size"
        android:visibility="gone"
        tools:text="How much of the video loads ahead"
        tools:visibility="visible" />

    <LinearLayout
        android:id="@+id/settings_segments"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginStart="12dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_settings_segment_track"
        android:orientation="horizontal"
        android:padding="4dp" />
</LinearLayout>
