<?xml version="1.0" encoding="utf-8"?>
<!--
  Touch Search screen (Wave 4b).

  Toolbar = back arrow + a rounded EditText (IME action = search) + a mic button for
  voice input. Below the toolbar, a horizontally-scrolling strip of tag SUGGESTION chips
  (fed live as the user types, via SearchPresenter's MediaServiceSearchTagProvider), and
  under that a single Material RecyclerView GRID of results (reuses VideoCardAdapter and
  the same runtime span-count math + onScrollEnd pagination as the Home/Channel grids).

  Drives the unchanged SearchPresenter via the standard MVP seam; this is the touch
  replacement for the Leanback SearchTagsFragment/SearchTagsActivity.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

<LinearLayout
    android:id="@+id/mobile_search_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/newtubeColorBackground"
    android:orientation="vertical">

    <!-- YEWPLAY(search): o topo da Busca na proposta (p. 14): campo grande com a lupa dentro e o X
         de limpar, "Cancelar" em texto ao lado (volta, como a seta antiga) e, depois de buscar, as
         abas por tipo com o ponto rubi. O microfone fica dentro do campo enquanto ele está vazio. -->
    <LinearLayout
        android:id="@+id/mobile_search_toolbar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/mobile_title_bar_height"
        android:background="?attr/newtubeColorBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/yew_side_margin"
        android:paddingEnd="8dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@drawable/mobile_search_field_background"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_yew_magnifier"
                android:tint="@color/mobile_color_on_surface_secondary" />

            <EditText
                android:id="@+id/mobile_search_input"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@null"
                android:hint="@string/mobile_search_hint"
                android:imeOptions="actionSearch"
                android:importantForAutofill="no"
                android:inputType="text"
                android:maxLines="1"
                android:paddingStart="10dp"
                android:paddingEnd="4dp"
                android:singleLine="true"
                android:textColor="@color/mobile_color_on_surface"
                android:textColorHint="@color/mobile_color_on_surface_secondary"
                android:textSize="15sp" />

            <!-- Clear the query; visible only while the field has text. -->
            <ImageButton
                android:id="@+id/mobile_search_clear"
                android:layout_width="40dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/mobile_search_clear"
                android:padding="11dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_yew_x_circle"
                android:tint="@color/mobile_color_on_surface_secondary"
                android:visibility="gone"
                tools:visibility="visible" />

            <ImageButton
                android:id="@+id/mobile_search_mic"
                android:layout_width="40dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/mobile_search_voice"
                android:padding="11dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_mobile_mic"
                android:tint="@color/mobile_color_on_surface_secondary" />
        </LinearLayout>

        <TextView
            android:id="@+id/mobile_search_back"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:fontFamily="@font/instrument_medium"
            android:gravity="center"
            android:paddingHorizontal="12dp"
            android:text="@string/yew_search_cancel"
            android:textColor="@color/mobile_color_on_surface_secondary"
            android:textSize="14.5sp" />

    </LinearLayout>

    <HorizontalScrollView
        android:id="@+id/mobile_search_filter_scroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:overScrollMode="never"
        android:scrollbars="none"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/mobile_search_filter_tabs"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/yew_filter_inset" />
    </HorizontalScrollView>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/mobile_search_grid"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingHorizontal="@dimen/mobile_card_spacing"
            android:paddingBottom="@dimen/mobile_card_spacing"
            android:scrollbars="vertical"
            tools:listitem="@layout/item_video_card" />

        <!-- NEWTUBE(motion): results load under card ghosts (the feed's shimmering skeleton), not
             a centered spinner; only over an empty list (MobileSearchActivity.showProgressBar). -->
        <include
            layout="@layout/mobile_feed_skeleton"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <!-- A search that ends with zero rows used to just... stop (spinner gone, screen
             blank). Shown by showProgressBar(false) when the grid is empty, worded by
             SearchLoadState: no connection / couldn't load (both with Try again) / no results. -->
        <include
            android:id="@+id/mobile_search_message"
            layout="@layout/mobile_page_load_state"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Suggestions/history: a full-height vertical list OVER the results while the user
             is editing the query (YouTube-style; was a one-line horizontal chip strip).
             Empty query = search history (clock rows), typed query = live suggestions. -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/mobile_search_suggestions"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="?attr/newtubeColorBackground"
            android:paddingTop="4dp"
            android:visibility="gone"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            tools:listitem="@layout/item_mobile_search_suggestion"
            tools:visibility="visible" />

    </FrameLayout>

</LinearLayout>

    <!-- Minimizing a video opened from these results keeps playback alive in this overlay. -->
    <include layout="@layout/mobile_mini_player_overlay" />

</FrameLayout>
