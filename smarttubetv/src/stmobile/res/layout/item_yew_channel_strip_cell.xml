<?xml version="1.0" encoding="utf-8"?>
<!-- YEWPLAY(subs): um canal da fileira - avatar em quadrado arredondado (32%), iniciais enquanto a
     foto não chega, ponto rubi quando há vídeo de hoje, nome embaixo. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="68dp"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackgroundBorderless"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingTop="4dp"
    android:paddingBottom="4dp">

    <FrameLayout
        android:layout_width="@dimen/yew_strip_avatar"
        android:layout_height="@dimen/yew_strip_avatar">

        <ImageView
            android:id="@+id/yew_strip_avatar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop" />

        <TextView
            android:id="@+id/yew_strip_initials"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fontFamily="@font/instrument_bold"
            android:gravity="center"
            android:importantForAccessibility="no"
            android:textColor="@color/mobile_color_on_surface"
            android:textSize="16sp" />

        <View
            android:id="@+id/yew_strip_dot"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_gravity="top|end"
            android:layout_marginTop="-3dp"
            android:layout_marginEnd="-3dp"
            android:background="@drawable/bg_yew_new_dot"
            android:visibility="gone" />
    </FrameLayout>

    <TextView
        android:id="@+id/yew_strip_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:gravity="center"
        android:importantForAccessibility="no"
        android:maxLines="1"
        android:paddingHorizontal="2dp"
        android:textColor="@color/mobile_color_on_surface_secondary"
        android:textSize="11sp" />
</LinearLayout>
