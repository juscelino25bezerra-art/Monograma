<?xml version="1.0" encoding="utf-8"?>
<!-- MONOGRAMA(visual): one app-icon option: the icon, its name, a line under it, and a coral
     check while it is the current one. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_weight="1"
    android:background="@drawable/bg_monograma_card"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingTop="20dp"
        android:paddingBottom="16dp">

        <ImageView
            android:id="@+id/settings_icon_image"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter"
            tools:src="@mipmap/app_icon" />

        <TextView
            android:id="@+id/settings_icon_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="@font/manrope_bold"
            android:textColor="@color/mobile_color_on_surface"
            android:textSize="16sp"
            tools:text="Grafite" />

        <TextView
            android:id="@+id/settings_icon_description"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/mobile_color_on_surface_secondary"
            android:textSize="13sp"
            tools:text="Default" />
    </LinearLayout>

    <ImageView
        android:id="@+id/settings_icon_check"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:layout_gravity="top|end"
        android:layout_margin="10dp"
        android:background="@drawable/bg_monograma_check_badge"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:padding="5dp"
        android:src="@drawable/ic_mobile_check"
        android:tint="@color/mobile_color_on_accent"
        android:visibility="gone"
        tools:visibility="visible" />
</FrameLayout>
