<?xml version="1.0" encoding="utf-8"?>
<!-- Home shell. One bottom nav (Home / Subscriptions / History / You) is the only structural
     navigation: the You tab hosts the account row, every extra BrowsePresenter section
     (Playlists, Music, ...) and the Settings entry, so there is no drawer and no settings
     icon in the top bar. -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mobile_browse_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/newtubeColorBackground"><!--
    No fitsSystemWindows needed: MobileActivity.applyMobileSystemBars() keeps the decor fitting
    the system windows (solid app-colored status/nav bars), so this layout never renders
    under the bars regardless of what the player did to the display in between. -->

    <!-- NEWTUBE(you-subscreen): back arrow shown (with the section's name in the title bar) only
         while a section opened from a You row is on screen - BrowseTopBar. GONE otherwise, and a
         GONE view collapses to a point at the start, so the wordmark keeps its 16dp inset. -->
    <ImageButton
        android:id="@+id/mobile_title_back"
        android:layout_width="48dp"
        android:layout_height="@dimen/mobile_title_bar_height"
        android:layout_marginStart="4dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/mobile_dialog_back"
        android:padding="12dp"
        android:src="@drawable/ic_mobile_back_arrow"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- MONOGRAMA(visual): the logo tile before the wordmark, on Home only (BrowseTopBar). -->
    <ImageView
        android:id="@+id/mobile_title_logo"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:layout_marginStart="16dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_monograma_logo"
        app:layout_constraintBottom_toBottomOf="@id/mobile_title_bar"
        app:layout_constraintStart_toEndOf="@id/mobile_title_back"
        app:layout_constraintTop_toTopOf="@id/mobile_title_bar" />

    <TextView
        android:id="@+id/mobile_title_bar"
        android:layout_width="0dp"
        android:layout_height="@dimen/mobile_title_bar_height"
        android:background="?attr/newtubeColorBackground"
        android:ellipsize="end"
        android:fontFamily="@font/manrope_extrabold"
        android:gravity="center_vertical|start"
        android:maxLines="1"
        android:paddingStart="12dp"
        android:text="@string/app_name"
        android:textColor="@color/mobile_color_on_surface"
        android:textSize="24sp"
        app:layout_constraintEnd_toStartOf="@id/mobile_cast_button"
        app:layout_constraintStart_toEndOf="@id/mobile_title_logo"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Cast picker entry on the home feed, like the official app's top bar. Tinted with the
         accent while a session is connected (MobileBrowseActivity.updateCastIconTint). -->
    <ImageButton
        android:id="@+id/mobile_cast_button"
        android:layout_width="48dp"
        android:layout_height="@dimen/mobile_title_bar_height"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/mobile_cast_button"
        android:padding="12dp"
        android:src="@drawable/ic_mobile_cast"
        app:layout_constraintEnd_toStartOf="@id/mobile_search_button"
        app:layout_constraintTop_toTopOf="@id/mobile_title_bar" />

    <!-- MONOGRAMA(visual): Settings on the You tab's top bar (the mockup), in place of Search. -->
    <ImageButton
        android:id="@+id/mobile_settings_button"
        android:layout_width="48dp"
        android:layout_height="@dimen/mobile_title_bar_height"
        android:layout_marginEnd="4dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/header_settings"
        android:padding="12dp"
        android:src="@drawable/ic_mobile_settings"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/mobile_title_bar" />

    <ImageButton
        android:id="@+id/mobile_search_button"
        android:layout_width="48dp"
        android:layout_height="@dimen/mobile_title_bar_height"
        android:layout_marginEnd="4dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/mobile_search_button"
        android:padding="12dp"
        android:src="@drawable/ic_mobile_search"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/mobile_title_bar" />

    <!-- MONOGRAMA(visual): the Downloads tab's header - the storage card and the sort chips -
         between the title bar and the list; GONE on every other tab (DownloadsHeader). The list
         and the empty state hang off it, so a GONE header collapses onto the title bar's edge. -->
    <LinearLayout
        android:id="@+id/mobile_downloads_header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/mobile_title_bar"
        tools:visibility="visible">

        <LinearLayout
            android:id="@+id/mobile_downloads_storage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_monograma_card"
            android:importantForAccessibility="yes"
            android:focusable="true"
            android:orientation="vertical"
            android:padding="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/manrope_bold"
                    android:importantForAccessibility="no"
                    android:text="@string/mobile_downloads_storage"
                    android:textColor="@color/mobile_color_on_surface"
                    android:textSize="17sp" />

                <TextView
                    android:id="@+id/mobile_downloads_storage_used"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:importantForAccessibility="no"
                    android:textColor="@color/mobile_color_on_surface_secondary"
                    android:textSize="14sp"
                    tools:text="1 video · 88.7 MB" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/mobile_downloads_storage_bar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:layout_marginTop="14dp"
                android:importantForAccessibility="no"
                android:max="1000"
                android:progressDrawable="@drawable/bg_monograma_storage_bar"
                tools:progress="40" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:importantForAccessibility="no"
                    android:text="@string/app_name"
                    android:textColor="@color/mobile_color_on_surface_secondary"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/mobile_downloads_storage_free"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:importantForAccessibility="no"
                    android:textColor="@color/mobile_color_on_surface_secondary"
                    android:textSize="13sp"
                    tools:text="Free on device: 12.3 GB" />
            </LinearLayout>
        </LinearLayout>

        <HorizontalScrollView
            android:id="@+id/mobile_downloads_sort_scroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:overScrollMode="never"
            android:scrollbars="none">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/mobile_downloads_sort"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:chipSpacingHorizontal="8dp"
                app:selectionRequired="true"
                app:singleLine="true"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/mobile_downloads_sort_recent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/mobile_downloads_sort_recent" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/mobile_downloads_sort_size"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/mobile_downloads_sort_size" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/mobile_downloads_sort_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/mobile_downloads_sort_name" />
            </com.google.android.material.chip.ChipGroup>
        </HorizontalScrollView>
    </LinearLayout>

    <!-- Pull-to-refresh drives BrowsePresenter.refresh() - also the natural retry
         gesture when a section shows the error placeholder (the error overlay doesn't
         consume touches, so the pull still reaches this layout). -->
    <com.newtube.mobile.ui.common.HapticSwipeRefreshLayout
        android:id="@+id/mobile_content_swipe"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/mobile_bottom_nav"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/mobile_downloads_header">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/mobile_content_grid"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingHorizontal="@dimen/mobile_card_spacing"
            android:paddingBottom="@dimen/mobile_card_spacing"
            android:scrollbars="vertical"
            tools:listitem="@layout/item_video_card" />

    </com.newtube.mobile.ui.common.HapticSwipeRefreshLayout>

    <include
        layout="@layout/mobile_feed_skeleton"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/mobile_bottom_nav"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/mobile_title_bar" />

    <!--
         The empty/error placeholder is anchored to the title bar / bottom nav / parent
         (NOT to the content grid): when a section is empty or sign-in gated the grid is
         set GONE, and ConstraintLayout collapses any view constrained to a GONE view to
         a zero-size point - which is exactly why the signed-out Subscriptions/Playlists
         sections used to render as a blank black area with no message. Independent
         anchors keep the placeholder centered and visible over the (empty) content area.
         (First-load progress is the card skeleton above, not a spinner.)
    -->
    <LinearLayout
        android:id="@+id/mobile_error_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/mobile_bottom_nav"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/mobile_downloads_header">

        <ImageView
            android:id="@+id/mobile_error_icon"
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:layout_marginBottom="16dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_mobile_empty" />

        <!-- MONOGRAMA(visual): a bold line above the message ("Watch without internet" on an
             empty Downloads tab); GONE elsewhere. -->
        <TextView
            android:id="@+id/mobile_error_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:fontFamily="@font/manrope_extrabold"
            android:gravity="center"
            android:textColor="@color/mobile_color_on_surface"
            android:textSize="20sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/mobile_error_message"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:lineSpacingMultiplier="1.15"
            android:textColor="@color/mobile_color_on_surface"
            android:textSize="16sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/mobile_error_action"
            style="@style/Widget.NewTube.Button.Pill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:visibility="gone" />

    </LinearLayout>

    <!-- "You" tab (replaces the old navigation drawer + top-bar settings icon): account row,
         every enabled BrowsePresenter section that isn't in the bottom nav, then Settings.
         Rows are inflated from item_mobile_you_row in MobileBrowseActivity.rebuildYouRows(). -->
    <ScrollView
        android:id="@+id/mobile_you_panel"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="?attr/newtubeColorBackground"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/mobile_bottom_nav"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/mobile_title_bar"
        tools:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <!-- Account header, official-app style: circular avatar (real account image via
                 Glide when signed in), name + "Manage account", chevron. Tap = sign in when signed
                 out, manage/switch accounts when signed in.
                 MONOGRAMA(visual): a rounded card, the initials on a coral disc until the picture
                 loads (InitialsAvatar). -->
            <LinearLayout
                android:id="@+id/mobile_you_account_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_monograma_card"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="20dp"
                android:paddingVertical="18dp">

                <ImageView
                    android:id="@+id/mobile_you_avatar"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_mobile_account" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/mobile_you_account_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:fontFamily="@font/manrope_extrabold"
                        android:maxLines="1"
                        android:text="@string/dialog_add_account"
                        android:textColor="@color/mobile_color_on_surface"
                        android:textSize="20sp" />

                    <TextView
                        android:id="@+id/mobile_you_account_sub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="@color/mobile_color_on_surface_secondary"
                        android:textSize="15sp"
                        android:visibility="gone" />

                </LinearLayout>

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_chevron_right"
                    android:tint="@color/mobile_color_on_surface_secondary" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/mobile_you_rows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

        </LinearLayout>

    </ScrollView>

    <!-- YouTube-style FLOATING mini-player: just the live video (no bar), a rounded card
         hovering over the grid's bottom-right corner above the bottom nav. GONE by default;
         it floats OVER content (like YouTube), so the grid keeps its bottom-nav constraint.
         The video is NOT a PlayerView: the card re-parents the playback activity's
         session-long SurfaceTexture into a code-managed TextureView inside the frame below
         (see MobileBrowseActivity#attachMiniTexture + MiniPlayerBridge.getSessionTexture) -
         the codec's surface never changes, so the hand-off never freezes playback. The
         freeze ImageView shows the last captured frame during attach/detach beats.
         Tap video = expand; overlaid play/pause + X; 2dp progress. -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/mobile_mini_player"
        android:contentDescription="@string/mobile_mini_expand"
        android:layout_width="180dp"
        android:layout_height="102dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="12dp"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone"
        app:cardBackgroundColor="@android:color/black"
        app:cardCornerRadius="12dp"
        app:cardElevation="8dp"
        app:layout_constraintBottom_toTopOf="@id/mobile_bottom_nav"
        app:layout_constraintEnd_toEndOf="parent"
        tools:visibility="visible">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- NEWTUBE(issue #9): an AspectRatioFrameLayout (FIT), given the video's shape by
                 MiniPlayerBridge.fitToVideo: other shapes are letterboxed, not stretched. -->
            <androidx.media3.ui.AspectRatioFrameLayout
                android:id="@+id/mobile_mini_player_frame"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center">

                <ImageView
                    android:id="@+id/mobile_mini_freeze"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no"
                    android:scaleType="fitXY"
                    android:visibility="gone" />

            </androidx.media3.ui.AspectRatioFrameLayout>

            <ImageButton
                android:id="@+id/mobile_mini_play_pause"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_mini_scrim_circle"
                android:contentDescription="@string/mobile_mini_play_pause"
                android:padding="9dp"
                android:src="@drawable/ic_player_pause" />

            <!-- 48dp touch target, wholly inside the card (a child outside its parent gets no touches), around the same 40dp circle (was 28dp, then 40dp - NEWTUBE(touch)). -->
            <ImageButton
                android:id="@+id/mobile_mini_close"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="top|end"
                android:layout_margin="0dp"
                android:background="@drawable/bg_mini_scrim_circle_touch"
                android:contentDescription="@string/mobile_mini_close"
                android:padding="15dp"
                android:src="@drawable/ic_sheet_close"
                android:tint="@color/mobile_player_on_video" />

            <ProgressBar
                android:id="@+id/mobile_mini_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:layout_gravity="bottom"
                android:max="1000"
                android:progressBackgroundTint="@color/mobile_color_progress_track"
                android:progressTint="@color/mobile_color_progress"
                tools:progress="400" />

        </FrameLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- Matched against the real YouTube app on a Pixel 9 (2026-07): their icon/label row
         measures ~51dp with 24dp icons and ~10sp labels, content centered, gesture inset
         absorbed below. Stock M2 wrap_content (56dp row) is the closest the widget allows;
         the view pads itself by the gesture-navigation inset (paddingBottomSystemWindowInsets)
         so the bar paints through to the display edge without squeezing the row. -->
    <!-- MONOGRAMA(visual): a hairline above the bar (the mockups), the bar itself on the page. -->
    <View
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="@color/mobile_color_divider"
        app:layout_constraintBottom_toTopOf="@id/mobile_bottom_nav"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/mobile_bottom_nav"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="?attr/newtubeColorBackground"
        app:itemActiveIndicatorStyle="@style/Widget.Monograma.BottomNav.ActiveIndicator"
        app:itemIconSize="24dp"
        app:itemIconTint="@color/monograma_nav_icon"
        app:itemPaddingTop="10dp"
        app:itemPaddingBottom="12dp"
        app:itemRippleColor="@android:color/transparent"
        app:itemTextAppearanceActive="@style/MobileBottomNavText.Active"
        app:itemTextAppearanceActiveBoldEnabled="false"
        app:itemTextAppearanceInactive="@style/MobileBottomNavText"
        app:paddingBottomSystemWindowInsets="true"
        app:itemTextColor="@color/monograma_nav_text"
        app:labelVisibilityMode="labeled"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
