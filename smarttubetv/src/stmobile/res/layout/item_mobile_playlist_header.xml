<?xml version="1.0" encoding="utf-8"?>
<!--
  Playlist page header, rendered as the FIRST (full-span) ITEM of the uploads grid (an item, not
  an AppBarLayout child - see git history for why).

  YEWPLAY(playlist): a página de playlist da proposta (p. 15) - capa em mosaico (as quatro
  primeiras miniaturas, quadrada, raio 14dp) com o nome em Bricolage ao lado e, embaixo,
  Reproduzir (marfim), Aleatório (fumaça) e o botão de Ouvir. Os itens vêm numerados.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mobile_channel_uploads_header"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingBottom="4dp">

    <!-- Kept for the holder; the proposal has no backdrop. -->
    <ImageView
        android:id="@+id/mobile_channel_uploads_backdrop"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:contentDescription="@null"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/yew_side_margin"
        android:paddingTop="4dp"
        android:paddingBottom="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="bottom"
            android:orientation="horizontal">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="@dimen/yew_playlist_cover"
                android:layout_height="@dimen/yew_playlist_cover"
                app:cardBackgroundColor="?attr/newtubeColorSurface"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <!-- One cover fills the square until the mosaic's four thumbnails are known. -->
                <ImageView
                    android:id="@+id/mobile_channel_uploads_cover"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:scaleType="centerCrop" />

                <GridLayout
                    android:id="@+id/yew_playlist_mosaic"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:columnCount="2"
                    android:rowCount="2"
                    android:visibility="gone">

                    <ImageView android:id="@+id/yew_mosaic_0" style="@style/YewMosaicTile" android:contentDescription="@null" />
                    <ImageView android:id="@+id/yew_mosaic_1" style="@style/YewMosaicTile" android:contentDescription="@null" />
                    <ImageView android:id="@+id/yew_mosaic_2" style="@style/YewMosaicTile" android:contentDescription="@null" />
                    <ImageView android:id="@+id/yew_mosaic_3" style="@style/YewMosaicTile" android:contentDescription="@null" />
                </GridLayout>
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/mobile_channel_uploads_header_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="@font/bricolage_bold"
                    android:letterSpacing="-0.015"
                    android:maxLines="3"
                    android:textColor="@color/mobile_color_on_surface"
                    android:textSize="24sp"
                    tools:text="Importante" />

                <TextView
                    android:id="@+id/mobile_channel_uploads_header_owner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/mobile_color_on_surface_secondary"
                    android:textSize="12.5sp"
                    tools:text="Playlist local" />

                <TextView
                    android:id="@+id/mobile_channel_uploads_header_meta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/mobile_color_on_surface_secondary"
                    android:textSize="12.5sp"
                    android:visibility="gone"
                    tools:text="4 vídeos, 1 h 12 min"
                    tools:visibility="visible" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/mobile_channel_uploads_header_play_all"
                style="@style/Widget.NewTube.Button.Pill"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/yew_playlist_play"
                app:icon="@drawable/ic_yew_play"
                app:iconGravity="textStart"
                app:iconSize="18dp"
                app:iconTint="@color/mobile_color_on_inverse_surface" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/mobile_channel_uploads_shuffle"
                style="@style/Widget.Yew.Button.Secondary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:text="@string/yew_playlist_shuffle"
                app:icon="@drawable/ic_yew_shuffle"
                app:iconGravity="textStart"
                app:iconSize="18dp"
                app:iconTint="@color/mobile_color_on_surface" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/yew_playlist_listen"
                style="@style/Widget.Yew.Button.Secondary"
                android:layout_width="48dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:contentDescription="@string/yew_watch_listen"
                android:minWidth="48dp"
                android:paddingStart="0dp"
                android:paddingEnd="0dp"
                app:icon="@drawable/ic_yew_headphones"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconSize="20dp"
                app:iconTint="@color/mobile_color_on_surface" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
