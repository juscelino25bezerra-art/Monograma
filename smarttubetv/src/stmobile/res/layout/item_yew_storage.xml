<?xml version="1.0" encoding="utf-8"?>
<!-- YEWPLAY(downloads): o espaço no topo da tela Downloads (proposta p. 16): "1,4 GB usados pelo
     app" à esquerda, "38 GB livres" à direita e uma barra fina com a parte usada em marfim. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/yew_side_margin"
    android:paddingTop="2dp"
    android:paddingEnd="@dimen/yew_side_margin"
    android:paddingBottom="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/yew_storage_used"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/mobile_color_on_surface_secondary"
            android:textSize="12.5sp"
            tools:text="1,4 GB usados pelo app" />

        <TextView
            android:id="@+id/yew_storage_free"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/mobile_color_on_surface_secondary"
            android:textSize="12.5sp"
            tools:text="38 GB livres" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/yew_storage_bar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:layout_marginTop="8dp"
        android:max="1000"
        android:progressBackgroundTint="@color/mobile_color_raised"
        android:progressTint="@color/mobile_color_on_surface" />
</LinearLayout>
