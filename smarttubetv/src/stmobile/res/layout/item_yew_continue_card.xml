<?xml version="1.0" encoding="utf-8"?>
<!-- YEWPLAY(library): um cartão de "Continue de onde parou" na Biblioteca (proposta, p. 15) -
     miniatura 176x99 de raio 12dp com a linha rubi do quanto já foi visto, título em duas linhas e o
     canal embaixo. Vem do estado local de reprodução (VideoStateService), não da rede. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="176dp"
    android:layout_height="wrap_content"
    android:layout_marginEnd="12dp"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="176dp"
        android:layout_height="99dp"
        app:cardBackgroundColor="@color/mobile_color_placeholder"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp">

        <ImageView
            android:id="@+id/yew_continue_thumb"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop" />

        <ProgressBar
            android:id="@+id/yew_continue_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_gravity="bottom"
            android:max="100"
            android:progressBackgroundTint="@color/mobile_color_progress_track"
            android:progressTint="@color/mobile_color_progress"
            tools:progress="60" />
    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/yew_continue_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="9dp"
        android:ellipsize="end"
        android:fontFamily="@font/instrument_semibold"
        android:maxLines="2"
        android:textColor="@color/mobile_color_on_surface"
        android:textSize="13.5sp"
        tools:text="Como montar uma rotina matinal que funciona de verdade" />

    <TextView
        android:id="@+id/yew_continue_meta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/mobile_color_on_surface_secondary"
        android:textSize="12sp"
        tools:text="Rotina Leve" />
</LinearLayout>
