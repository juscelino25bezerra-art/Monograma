<?xml version="1.0" encoding="utf-8"?>
<!-- Shimmering (ShimmerLinearLayout) loading skeleton for the feed grids. Shown only while a section
     loads into an EMPTY grid - never over content.
     YEWPLAY(skeleton): no formato novo (proposta, "esqueleto de carregamento") - dois desenhos no
     mesmo esqueleto; o compacto é o padrão (Busca) e MobileBrowseActivity.setSkeletonShape mostra o que a tela vai ter: o item grande
     do Início (tag "large": miniatura de ponta a ponta, texto na margem de 20dp) ou o item compacto
     das listas (tag "compact": miniatura 144x81 de raio 10dp e três linhas ao lado). -->
<com.newtube.mobile.ui.common.ShimmerLinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mobile_feed_skeleton"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:visibility="visible">

    <LinearLayout style="@style/MobileSkeletonFeedCard" android:tag="large" android:visibility="gone">
        <View style="@style/MobileSkeletonFeedThumb" />
        <LinearLayout style="@style/MobileSkeletonFeedTextRow">
            <View style="@style/MobileSkeletonFeedAvatar" />
            <LinearLayout style="@style/MobileSkeletonFeedText">
                <View style="@style/MobileSkeletonFeedLineWide" />
                <View style="@style/MobileSkeletonFeedLineNarrow" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout style="@style/MobileSkeletonFeedCard" android:tag="large" android:visibility="gone">
        <View style="@style/MobileSkeletonFeedThumb" />
        <LinearLayout style="@style/MobileSkeletonFeedTextRow">
            <View style="@style/MobileSkeletonFeedAvatar" />
            <LinearLayout style="@style/MobileSkeletonFeedText">
                <View style="@style/MobileSkeletonFeedLineWide" />
                <View style="@style/MobileSkeletonFeedLineNarrow" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout style="@style/MobileSkeletonFeedCard" android:tag="large" android:visibility="gone">
        <View style="@style/MobileSkeletonFeedThumb" />
        <LinearLayout style="@style/MobileSkeletonFeedTextRow">
            <View style="@style/MobileSkeletonFeedAvatar" />
            <LinearLayout style="@style/MobileSkeletonFeedText">
                <View style="@style/MobileSkeletonFeedLineWide" />
                <View style="@style/MobileSkeletonFeedLineNarrow" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout style="@style/YewSkeletonRow" android:tag="compact">
        <View style="@style/YewSkeletonRowThumb" />
        <LinearLayout style="@style/MobileSkeletonFeedText">
            <View style="@style/YewSkeletonRowLineWide" />
            <View style="@style/YewSkeletonRowLineMid" />
            <View style="@style/YewSkeletonRowLineNarrow" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout style="@style/YewSkeletonRow" android:tag="compact">
        <View style="@style/YewSkeletonRowThumb" />
        <LinearLayout style="@style/MobileSkeletonFeedText">
            <View style="@style/YewSkeletonRowLineWide" />
            <View style="@style/YewSkeletonRowLineMid" />
            <View style="@style/YewSkeletonRowLineNarrow" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout style="@style/YewSkeletonRow" android:tag="compact">
        <View style="@style/YewSkeletonRowThumb" />
        <LinearLayout style="@style/MobileSkeletonFeedText">
            <View style="@style/YewSkeletonRowLineWide" />
            <View style="@style/YewSkeletonRowLineMid" />
            <View style="@style/YewSkeletonRowLineNarrow" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout style="@style/YewSkeletonRow" android:tag="compact">
        <View style="@style/YewSkeletonRowThumb" />
        <LinearLayout style="@style/MobileSkeletonFeedText">
            <View style="@style/YewSkeletonRowLineWide" />
            <View style="@style/YewSkeletonRowLineMid" />
            <View style="@style/YewSkeletonRowLineNarrow" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout style="@style/YewSkeletonRow" android:tag="compact">
        <View style="@style/YewSkeletonRowThumb" />
        <LinearLayout style="@style/MobileSkeletonFeedText">
            <View style="@style/YewSkeletonRowLineWide" />
            <View style="@style/YewSkeletonRowLineMid" />
            <View style="@style/YewSkeletonRowLineNarrow" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout style="@style/YewSkeletonRow" android:tag="compact">
        <View style="@style/YewSkeletonRowThumb" />
        <LinearLayout style="@style/MobileSkeletonFeedText">
            <View style="@style/YewSkeletonRowLineWide" />
            <View style="@style/YewSkeletonRowLineMid" />
            <View style="@style/YewSkeletonRowLineNarrow" />
        </LinearLayout>
    </LinearLayout>

</com.newtube.mobile.ui.common.ShimmerLinearLayout>
