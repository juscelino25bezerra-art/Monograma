<?xml version="1.0" encoding="utf-8"?>
<!-- MONOGRAMA(visual): the app's typeface, Manrope (SIL OFL 1.1, THIRD_PARTY_NOTICES.md). The
     theme sets this family as the default for every text; textStyle="bold" picks the 700 weight.
     A medium-weight text (what used to be sans-serif-medium) names @font/manrope_semibold. -->
<font-family xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <font android:font="@font/manrope_regular" android:fontStyle="normal" android:fontWeight="400"
        app:font="@font/manrope_regular" app:fontStyle="normal" app:fontWeight="400" />
    <font android:font="@font/manrope_medium" android:fontStyle="normal" android:fontWeight="500"
        app:font="@font/manrope_medium" app:fontStyle="normal" app:fontWeight="500" />
    <font android:font="@font/manrope_semibold" android:fontStyle="normal" android:fontWeight="600"
        app:font="@font/manrope_semibold" app:fontStyle="normal" app:fontWeight="600" />
    <font android:font="@font/manrope_bold" android:fontStyle="normal" android:fontWeight="700"
        app:font="@font/manrope_bold" app:fontStyle="normal" app:fontWeight="700" />
    <font android:font="@font/manrope_extrabold" android:fontStyle="normal" android:fontWeight="800"
        app:font="@font/manrope_extrabold" app:fontStyle="normal" app:fontWeight="800" />
</font-family>
