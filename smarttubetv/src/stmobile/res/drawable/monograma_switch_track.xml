<?xml version="1.0" encoding="utf-8"?>
<!-- MONOGRAMA(visual): the switch track, a 52x32dp pill: coral when on, outlined when off. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <size android:width="52dp" android:height="32dp" />
            <corners android:radius="16dp" />
            <solid android:color="@color/mobile_color_accent" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <size android:width="52dp" android:height="32dp" />
            <corners android:radius="16dp" />
            <solid android:color="@color/mobile_color_raised" />
            <stroke android:width="2dp" android:color="@color/monograma_switch_thumb_off" />
        </shape>
    </item>
</selector>
