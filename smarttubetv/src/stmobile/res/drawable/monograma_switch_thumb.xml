<?xml version="1.0" encoding="utf-8"?>
<!-- MONOGRAMA(visual): the switch thumb, 32dp tall so it spans the track (SwitchCompat draws the
     thumb the track's height): a white 24dp disc when on, a grey 16dp one when off. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false" android:state_checked="true">
        <layer-list>
            <item android:width="32dp" android:height="32dp"><shape android:shape="oval"><solid android:color="@android:color/transparent" /></shape></item>
            <item android:left="4dp" android:top="4dp" android:right="4dp" android:bottom="4dp"><shape android:shape="oval"><solid android:color="#99FFFFFF" /></shape></item>
        </layer-list>
    </item>
    <item android:state_checked="true">
        <layer-list>
            <item android:width="32dp" android:height="32dp"><shape android:shape="oval"><solid android:color="@android:color/transparent" /></shape></item>
            <item android:left="4dp" android:top="4dp" android:right="4dp" android:bottom="4dp"><shape android:shape="oval"><solid android:color="#FFFFFF" /></shape></item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item android:width="32dp" android:height="32dp"><shape android:shape="oval"><solid android:color="@android:color/transparent" /></shape></item>
            <item android:left="8dp" android:top="8dp" android:right="8dp" android:bottom="8dp"><shape android:shape="oval"><solid android:color="@color/monograma_switch_thumb_off" /></shape></item>
        </layer-list>
    </item>
</selector>
