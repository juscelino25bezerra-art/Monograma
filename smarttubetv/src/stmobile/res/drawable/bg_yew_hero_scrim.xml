<?xml version="1.0" encoding="utf-8"?>
<!-- YEWPLAY(home): o degradê do destaque do Início - um véu leve no alto (para a duração e o ⋮
     brancos se lerem), limpo no meio e quase grafite embaixo, sob o título. Fixo nos dois temas:
     fica sobre a foto. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:gravity="top" android:height="72dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="#000E0F11"
                android:startColor="#730E0F11" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:centerColor="#590E0F11"
                android:centerY="0.55"
                android:endColor="#F20E0F11"
                android:startColor="#000E0F11" />
        </shape>
    </item>
</layer-list>
