<?xml version="1.0" encoding="utf-8"?>
<!-- YEWPLAY(home): o ⋮ do destaque - um círculo escuro de 32dp atrás dos pontos brancos, para não
     sumirem sobre uma foto clara; o toque continua com o ripple de sempre. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="?android:attr/colorControlHighlight">
    <item>
        <inset android:inset="8dp">
            <shape android:shape="oval">
                <solid android:color="#6618141A" />
            </shape>
        </inset>
    </item>
</ripple>
