<?xml version="1.0" encoding="utf-8"?>
<!-- YEWPLAY(visual): trilho do interruptor (Widget.Yew.Switch). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <size android:width="44dp" android:height="26dp" />
            <corners android:radius="13dp" />
            <solid android:color="@color/mobile_color_on_surface" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <size android:width="44dp" android:height="26dp" />
            <corners android:radius="13dp" />
            <solid android:color="@color/mobile_color_raised" />
        </shape>
    </item>
</selector>
